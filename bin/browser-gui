#!/usr/bin/env bash
set -Eeuo pipefail

DISPLAY="${DISPLAY:-:99}"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omp-devbox-${UID}"
VNC_DIR="/persist/vnc"
PASSFILE="$VNC_DIR/passwd"
NOVNC_PORT="${DEVBOX_NOVNC_PORT:-6080}"
VNC_PORT="${DEVBOX_VNC_PORT:-5900}"
mkdir -p "$STATE_DIR" "$VNC_DIR"

pidfile() { printf '%s/%s.pid' "$STATE_DIR" "$1"; }
logfile() { printf '%s/%s.log' "$STATE_DIR" "$1"; }

pid_alive() {
  local file="$1" pid
  [[ -f "$file" ]] || return 1
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

require_password() {
  if [[ ! -s "$PASSFILE" ]]; then
    cat >&2 <<MSG
No VNC password configured.
Set DEVBOX_VNC_PASSWORD in the ZimaOS app environment and restart the container,
or run interactively: browser-gui password
MSG
    return 1
  fi
}

set_password() {
  if [[ ! -t 0 ]]; then
    echo "browser-gui password requires an interactive terminal" >&2
    return 2
  fi
  local a b
  read -r -s -p 'New VNC password: ' a; echo
  read -r -s -p 'Repeat VNC password: ' b; echo
  [[ -n "$a" ]] || { echo 'Password cannot be empty' >&2; return 2; }
  [[ "$a" == "$b" ]] || { echo 'Passwords do not match' >&2; return 2; }
  x11vnc -storepasswd "$a" "$PASSFILE" >/dev/null
  chmod 600 "$PASSFILE"
  echo "VNC password stored"
}

start_proc() {
  local name="$1"; shift
  local pf; pf="$(pidfile "$name")"
  if pid_alive "$pf"; then return 0; fi
  rm -f "$pf"
  nohup "$@" >"$(logfile "$name")" 2>&1 &
  echo $! > "$pf"
}

start() {
  require_password
  browser-service start >/dev/null

  start_proc x11vnc x11vnc \
    -display "$DISPLAY" \
    -localhost \
    -rfbport "$VNC_PORT" \
    -rfbauth "$PASSFILE" \
    -forever -shared -noxdamage -repeat

  sleep 0.3
  start_proc novnc websockify \
    --web=/usr/share/novnc \
    "0.0.0.0:${NOVNC_PORT}" \
    "127.0.0.1:${VNC_PORT}"

  sleep 0.3
  if ! pid_alive "$(pidfile novnc)"; then
    echo "noVNC failed to start. Run: browser-gui logs" >&2
    return 1
  fi

  echo "Browser GUI enabled on container port ${NOVNC_PORT}."
  if [[ -n "${DEVBOX_GUI_URL:-}" ]]; then
    echo "Open: ${DEVBOX_GUI_URL}"
  else
    echo "Open the ZimaOS host/IP on mapped port ${NOVNC_PORT}: /vnc.html?autoconnect=1&resize=scale"
  fi
}

stop_one() {
  local name="$1" pf pid
  pf="$(pidfile "$name")"
  if pid_alive "$pf"; then
    pid="$(cat "$pf")"
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$pf"
}

stop() {
  stop_one novnc
  stop_one x11vnc
  echo "Browser GUI disabled. Chromium is still running."
}

status() {
  local on=0
  if pid_alive "$(pidfile x11vnc)"; then
    echo "x11vnc: running"
  else
    echo "x11vnc: stopped"
    on=1
  fi
  if pid_alive "$(pidfile novnc)"; then
    echo "noVNC:  running on port ${NOVNC_PORT}"
  else
    echo "noVNC:  stopped"
    on=1
  fi
  return "$on"
}

logs() {
  for name in x11vnc novnc; do
    printf '\n===== %s =====\n' "$name"
    tail -n 100 "$(logfile "$name")" 2>/dev/null || true
  done
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  password) set_password ;;
  logs) logs ;;
  *) echo "Usage: browser-gui {start|stop|restart|status|password|logs}" >&2; exit 2 ;;
esac
